PORT=3001
HOST=127.0.0.1
# Trust only these reverse proxy peers; set empty for direct access.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
APP_URL=http://127.0.0.1:5173
APP_ENV=development
DATA_DIR=./data
FRONTEND_DIR=./dist
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=phantomframe
MYSQL_PASSWORD=replace-with-your-database-password
# Only required by compose.yaml; the Go API does not use the root account.
MYSQL_ROOT_PASSWORD=replace-with-a-separate-root-password
MYSQL_DATABASE=phantomframe
REDIS_ADDR=127.0.0.1:6380
REDIS_PASSWORD=replace-with-your-redis-password
REDIS_DB=0
REDIS_PREFIX=phantomframe:
# Turn this off when connecting real paid providers.
DEMO_MODE=true
FFPROBE_PATH=
# On first run, unset ADMIN_PASSWORD generates .local-credentials.json.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Required in production: random 64-character hex key. Keep it with database backups.
ENCRYPTION_KEY=
COOKIE_SECURE=false
# Production defaults to OSS; local development may keep local files until configured.
# STORAGE_DRIVER=local
OSS_BUCKET=flowlinght
OSS_REGION=cn-shanghai
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_ACCELERATE_ENDPOINT=https://flowlinght.oss-accelerate.aliyuncs.com
OSS_UPLOAD_ACCELERATE=true
OSS_READ_ACCELERATE=true
OSS_PREFIX=phantomframe/uploads/
OSS_CDN_DOMAIN=
OSS_PUBLIC_READ=false
OSS_URL_TTL=3600
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional: import a provider inventory from a local, secret CSV at startup.
# Unchanged CSV is skipped on subsequent starts. Never commit this file's contents.
PROVIDER_INVENTORY_FILE=
