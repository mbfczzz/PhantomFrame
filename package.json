{
  "name": "phantomframe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"go run ./cmd/api\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "go run ./cmd/api",
    "services": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-services.ps1",
    "build": "npm run build:web && npm run build:server",
    "build:web": "tsc -p tsconfig.json && vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node scripts/start-api.mjs",
    "test": "node scripts/test-backend.mjs",
    "migrate:export": "node scripts/export-sqlite.mjs",
    "migrate:import": "go run ./cmd/migrate",
    "test:ui": "node scripts/test-ui.mjs",
    "test:upstream-ui": "node scripts/test-upstream-ui.mjs",
    "test:audit-ui": "node scripts/test-audit-ui.mjs",
    "test:recheck-ui": "node scripts/test-recheck-ui.mjs",
    "test:inventory-ui": "node scripts/test-inventory-ui.mjs",
    "test:opencrow-ui": "node scripts/test-opencrow-ui.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "@xyflow/react": "^12.8.6",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "axe-core": "^4.14.0",
    "concurrently": "^9.2.1",
    "playwright": "^1.58.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
