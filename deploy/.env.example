# Copy to deploy/.env (or .env beside docker-compose.yml on the server).
PHANTOMFRAME_IMAGE=ghcr.io/mbfczzz/phantomframe:latest
APP_ENV=production
HOST=127.0.0.1
# Host Nginx is the only trusted proxy. Empty disables forwarded client addresses.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
PORT=3001
APP_URL=https://phantomframe.tcmzhan.com
DATA_DIR=/app/data
FRONTEND_DIR=/app/dist
DEMO_MODE=false
COOKIE_SECURE=true
# Generate with openssl rand -hex 32; keep this key stable with database backups.
ENCRYPTION_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=phantomframe
MYSQL_USER=root
MYSQL_PASSWORD=
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=phantomframe:
STORAGE_DRIVER=oss
OSS_BUCKET=flowlinght
OSS_REGION=cn-shanghai
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_ACCELERATE_ENDPOINT=https://flowlinght.oss-accelerate.aliyuncs.com
OSS_UPLOAD_ACCELERATE=true
OSS_READ_ACCELERATE=true
OSS_PREFIX=phantomframe/uploads/
OSS_CDN_DOMAIN=
OSS_PUBLIC_READ=false
OSS_URL_TTL=3600
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
